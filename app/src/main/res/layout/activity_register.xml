<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay lại"
                android:gravity="center"
                android:text="‹"
                android:textColor="#475569"
                android:textSize="32sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🎓  Create Account"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_recovery_icon"
                android:gravity="center"
                android:text="♟"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Intro card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFF1C2"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="✨  Nhận ngay bài test đánh giá miễn phí"
                android:textColor="#925D00"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tạo tài khoản"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bắt đầu hành trình nâng band IELTS Reading &amp; Writing của bạn."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_recovery_badge"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:text="▤  Reading 8.5+"
                    android:textColor="#1265A8"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_recovery_badge"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:text="✍  Writing AI"
                    android:textColor="#1265A8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Full name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Họ và tên"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_login_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="♙"
                android:textColor="#64748B"
                android:textSize="17sp" />

            <EditText
                android:id="@+id/edtFullName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="name"
                android:background="@android:color/transparent"
                android:hint="Nguyễn Văn A"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#8A94A6"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="Địa chỉ Email"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_login_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✉"
                android:textColor="#64748B"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="emailAddress"
                android:background="@android:color/transparent"
                android:hint="example@email.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#8A94A6"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="Mật khẩu"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_login_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="3dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="♙"
                android:textColor="#64748B"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="newPassword"
                android:background="@android:color/transparent"
                android:hint="Ít nhất 6 ký tự"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#8A94A6"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnTogglePassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hiện hoặc ẩn mật khẩu"
                android:gravity="center"
                android:text="◎"
                android:textColor="#64748B"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Password strength -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressPasswordStrength"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:max="4"
                android:progress="0"
                android:progressBackgroundTint="#DCE5F1"
                android:progressTint="#087CC1" />

            <TextView
                android:id="@+id/tvPasswordStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Gồm chữ và số"
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Confirm password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Xác nhận mật khẩu"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_login_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="3dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◉"
                android:textColor="#64748B"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="newPassword"
                android:background="@android:color/transparent"
                android:hint="Nhập lại mật khẩu"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#8A94A6"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnToggleConfirmPassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hiện hoặc ẩn mật khẩu xác nhận"
                android:gravity="center"
                android:text="◎"
                android:textColor="#64748B"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Terms -->
        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:buttonTint="#154378"
            android:minHeight="48dp"
            android:paddingEnd="4dp"
            android:text="Tôi đồng ý với Điều khoản dịch vụ và Chính sách bảo mật của IELTSPro."
            android:textColor="#64748B"
            android:textSize="10sp" />

        <!-- Register button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:backgroundTint="#154378"
            android:minHeight="50dp"
            android:text="Đăng ký  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="hoặc"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- Google button with logo -->
        <LinearLayout
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_login_input"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:contentDescription="Tiếp tục với Google">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_google"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Google" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Tiếp tục với Google"
                android:textColor="#1E293B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Apple button with logo -->
        <LinearLayout
            android:id="@+id/btnApple"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_input"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:contentDescription="Tiếp tục với Apple">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_apple"
                android:scaleType="fitCenter"
                android:contentDescription="Logo Apple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Tiếp tục với Apple"
                android:textColor="#1E293B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Login link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản? "
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Đăng nhập"
                android:textColor="#154378"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
