<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp">

        <!-- Thanh tiêu đề -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#172033"
                android:textSize="26sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay lại" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Account Recovery"
                android:textColor="#172033"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_recovery_icon"
                android:gravity="center"
                android:text="♙"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />
        </LinearLayout>

        <!-- Nhãn giới thiệu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_recovery_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="✓ IELTSPro Security • Khôi phục"
            android:textColor="#154378"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Đặt lại mật khẩu"
            android:textColor="#172033"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Nhập email học tập để nhận liên kết xác thực an toàn và bảo mật cho tài khoản của bạn."
            android:textColor="#68758A"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <!-- Thẻ nhập email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_recovery_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Địa chỉ Email"
                    android:textColor="#172033"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_recovery_badge"
                    android:padding="6dp"
                    android:text="Email đã đăng ký"
                    android:textColor="#52647A"
                    android:textSize="10sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_login_input"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:drawablePadding="10dp"
                android:hint="Nhập email đã đăng ký"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#172033"
                android:textColorHint="#8995A8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSendReset"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#154378"
                android:text="Gửi liên kết xác nhận  ➤"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Thông báo bảo mật -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_recovery_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="♙"
                    android:textColor="#154378"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đường dẫn đặt lại mật khẩu có hiệu lực trong vòng 15 phút vì lý do an toàn học vụ."
                    android:textColor="#52647A"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Thẻ thông báo sau khi gửi -->
        <LinearLayout
            android:id="@+id/layoutEmailSent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_recovery_card"
            android:elevation="1dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_recovery_badge"
                android:gravity="center"
                android:text="✉"
                android:textColor="#154378"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Kiểm tra hộp thư của bạn"
                android:textColor="#172033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Đây là giao diện minh họa. Chức năng gửi email khôi phục cần được kết nối API."
                android:textColor="#68758A"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/tvBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FFFFFF"
                android:text="← Quay lại đăng nhập"
                android:textAllCaps="false"
                android:textColor="#154378"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvResendEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="ⓘ Chưa nhận được email? Gửi lại ngay."
                android:textColor="#68758A"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="◉ Cần thêm trợ giúp? Hỗ trợ IELTSPro"
            android:textColor="#68758A"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
